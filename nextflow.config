/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    skimseq Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs

params {

    help                        = null

    slurm_account               = null                              // account to use on SLURM

    ///// Primary inputs
    samplesheet                 = null                              // path to samplesheet.csv file (sample, r1, r2, pop)
    ref_genome                  = null                              // path to reference genome
    mito_contig                 = null                              // Name of mitochondrial contig
    ref_panel                   = null                              // path to VCF reference panel
    ref_panel_samplesheet       = null                              // path to reference panel samplesheet.csv file (sample, pop)
    
    ///// Intermediate inputs & outputs
    use_existing_cram           = true                              // Whether to use existing crams in output/results/cram, even if the work directory has been deleted
    use_existing_gvcf           = true                              // Whether to use existing crams in output/results/vcf/gvcf, even if the work directory has been deleted
    skip_cram_validation        = false                             // Whether validation of existing crams should be skipped
    skip_gvcf_validation        = false                             // Whether validation of existing gvcfs should be skipped
    output_cram                 = true                              // Whether to output CRAM files; boolean

    ///// Parallelisation parameters
    fastq_chunk_size            = 1E7                               // number of reads .fastq files should be split into for mapping to genome
    variants_per_chunk          = 1e6                               // Number of variants per process for genotyping

    ///// BWA-mem2 alignment parameters
    bwa_min_seed_length         = 19                                // minimum seed (kmer) length for seeding alignments; integer
    bwa_max_seed_occurance      = 250                               // skip seeds that occur more than N times in the reference. Lower values reduce number of reads mapping to repeats, and can resolve BWA-mem2 crashes; integer

    ///// BCFTools variant calling
    rmdup                    = true                                 // Exclude duplicate aligned reads from genotyping; logical
    minbq                    = 10                                   // Minimum base quality for genotyping; integer
    minmq                    = 20                                   // Minimum mapping quality for genotyping; integer
    min_fragment_length      = 15                                   // Minimum length of fragment (insert size)
    max_fragment_length      = 10000                                // Maximum length of fragment (insert size)
    min_aligned_length       = 30                                   // Minimum number of aligned (non-soft clipped) bases in read
    ploidy                   = 2                                    // Ploidy of the samples; integer
    mutation_rate            = 1.1e-3                               // mutation rate value used to compute prior probabilities for any locus. Increase for more sensitivity; float
    max_depth                = 250                                  // Maximum number of reads to use per file. Increase if doing deep targetted sequencing; integer
    ref_panel_priors         = true                                 // Use AN and AF from ref panel as priors for genotype calling

    // PLINK2 Filters
    min_mac                  = 3
    min_maf                  = 0.05
    site_max_missing         = 0.4
    sample_max_missing       = 0.4
    ld_winsize               = 200
    ld_stepsize              = 50
    ld_threshold             = 0.2
    plink_num_pc             = 10

    ///// debugging options
    debug_mode                  = false                             // save all module outputs to results/modules; boolean
    rdata                       = false                             // save all data/objects from process-level R sessions as .RData files in work dir; boolean

    ///// Max resource options per task/process
    // Defaults only, expecting to be overwritten
    max_memory                  = '128.GB'
    max_cpus                    = 16
    max_time                    = '240.h'
    scratch                     = false

}


validation {

    failUnrecognisedParams      = false                             // run will fail if unrecognised parameters are given, not just give a warning

}


profiles {

    basc_modules {
        process.executor                = 'slurm'
        process.queue                   = 'batch,shortrun'
        process.clusterOptions          = "--account $params.slurm_account --ntasks=1 --exclude=cpu018,cpu019"
        params.max_memory               = '512.GB'
        params.max_time                 = '168.h'
        params.max_cpus                 = 48
        executor.queueSize              = 200
        executor.pollInterval           = '10 sec'
        executor.submitRateLimit        = '5 sec'
        executor.perCpuMemAllocation    = true
        executor.onlyJobState           = true
        executor.queueGlobalStatus      = true
        params.scratch                  = true
    }
    basc_shifter {
        process.executor                = 'slurm'
        process.queue                   = 'batch,shortrun'
        process.clusterOptions          = "--account $params.slurm_account --ntasks=1 --exclude=cpu018,cpu019"
        params.max_memory               = '512.GB'
        params.max_time                 = '168.h'
        params.max_cpus                 = 48
        executor.queueSize              = 200
        executor.pollInterval           = '10 sec'
        executor.submitRateLimit        = '5 sec'
        executor.perCpuMemAllocation    = true
        executor.onlyJobState           = true
        executor.queueGlobalStatus      = true
        process.module                  = 'shifter' // this runs 'module load shifter' at the start of each process job
        shifter.enabled                 = true
        params.scratch                  = true
    }       
    test { /// this profile should always be specified last to force the minimal resource requirements
        params.samplesheet              = 'test_data/qfly/test_samplesheet.csv' // Qfly test data
        params.ref_genome               = 'test_data/qfly/test_qfly_genome.fa' // Qfly genome subset to 50-100kb
        params.ref_panel                = 'test_data/qfly/panel.vcf.gz'
        params.ref_panel_samplesheet    = 'test_data/qfly/panel_samplesheet.csv'
        params.mito_contig              = 'HQ130030.1'
        params.fastq_chunk_size	      	= 3000
        params.variants_per_chunk       = 50   
        params.plink_num_pc             = 2                 
        params.max_memory               = '2.GB'
        params.max_time                 = '10.m'
        params.max_cpus                 = 1
        params.scratch                  = false
    }       
    debug {     
        params.rdata                    = true
        params.all_fasta                = true
        params.save_intermediate        = true
        params.debug_mode               = true
        params.scratch                  = false
    }           
    apptainer {         
        apptainer.enabled               = true
        apptainer.autoMounts            = true
        charliecloud.enabled            = false
        conda.enabled                   = false
        docker.enabled                  = false
        podman.enabled                  = false        
        shifter.enabled                 = false
        singularity.enabled             = false
    }           
    docker {            
        apptainer.enabled               = false
        charliecloud.enabled            = false
        conda.enabled                   = false
        docker.enabled                  = true
        docker.runOptions               = '-u $(id -u):$(id -g)'
        podman.enabled                  = false        
        shifter.enabled                 = false
        singularity.enabled             = false
    }           
    podman {            
        apptainer.enabled               = false
        charliecloud.enabled            = false
        conda.enabled                   = false
        docker.enabled                  = false
        podman.enabled                  = true        
        shifter.enabled                 = false
        singularity.enabled             = false
    }           
    shifter {           
        apptainer.enabled               = false
        charliecloud.enabled            = false
        conda.enabled                   = false
        docker.enabled                  = false
        podman.enabled                  = false        
        shifter.enabled                 = true
        singularity.enabled             = false
    }           
    singularity {           
        apptainer.enabled               = false
        charliecloud.enabled            = false
        conda.enabled                   = false
        docker.enabled                  = false
        podman.enabled                  = false        
        shifter.enabled                 = false
        singularity.enabled             = true
        singularity.autoMounts          = true
    }


}


process {

    // Use the param to control the scratch directive
    scratch = params.scratch

    // error handling
    errorStrategy = { task.exitStatus in ((130..145) + 104 + 247) ? 'retry' : 'finish' }
    maxRetries    = 3
    maxErrors     = '-1'
    withLabel: error_retry {
        errorStrategy = 'retry'
        maxRetries    = 3
    }


    // Main & generic process resources
    withName: INDEX_GENOME {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 32.GB,  task.attempt ) }
        time    = { time_scale ( 30.m,   task.attempt ) }
    }    
    withName: INDEX_MITO {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 4.GB,  task.attempt ) }
        time    = { time_scale ( 10.m,   task.attempt ) }
    }    
    withName: EXTRACT_VCF_SITES {
        cpus    = { cpu_scale  ( 4,     task.attempt ) }
        memory  = { mem_scale  ( 24.GB,  task.attempt ) }
        time    = { time_scale ( 30.m,   task.attempt ) }
    }    
    withName: SCATTER_VCF {
        cpus    = { cpu_scale  ( 4,     task.attempt ) }
        memory  = { mem_scale  ( 24.GB,  task.attempt ) }
        time    = { time_scale ( 30.m,   task.attempt ) }
    }    
     
    // process_reads subworkflow resources
    withName: VALIDATE_FASTQ {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 4.GB,  task.attempt ) }
        time    = { time_scale ( 1.h,   task.attempt ) }
    }
    withName: VALIDATE_CRAM {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 4.GB,  task.attempt ) }
        time    = { time_scale ( 1.h,   task.attempt ) }
    }
    withName: REPAIR_FASTQ {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 40.GB,  task.attempt ) }
        time    = { time_scale ( 1.h,   task.attempt ) }
    }
    withName: SPLIT_FASTQ {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 4.GB,  task.attempt ) }
        time    = { time_scale ( 10.m,   task.attempt ) }
    }   
    withName: MAP_TO_GENOME {
        cpus    = { cpu_scale  ( 8,     task.attempt ) }
        memory  = { mem_scale  ( 24.GB,  task.attempt ) }
        time    = { time_scale ( 2.h,   task.attempt ) }
    }
    withName: MERGE_CRAM {
        cpus    = { cpu_scale  ( 4,     task.attempt ) }
        memory  = { mem_scale  ( 16.GB,  task.attempt ) }
        time    = { time_scale ( 2.h,   task.attempt ) }
    }
    withName: STAGE_CRAM {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 1.GB,  task.attempt ) }
        time    = { time_scale ( 1.h,   task.attempt ) }
        executor = 'local'
    }
    
    // BCFTools genotyping subworkflow
    withName: MPILEUP_SINGLE {
        cpus    = { cpu_scale  ( 4,     task.attempt ) }
        memory  = { mem_scale  ( 24.GB,  task.attempt ) }
        time    = { time_scale ( 6.h,   task.attempt ) }
    }    
    withName: CONCAT_VCFS {
        cpus    = { cpu_scale  ( 8,     task.attempt ) }
        memory  = { mem_scale  ( 48.GB,  task.attempt ) }
        time    = { time_scale ( 6.h,   task.attempt ) }
    }  
    withName: MERGE_VCFS {
        cpus    = { cpu_scale  ( 8,     task.attempt ) }
        memory  = { mem_scale  ( 48.GB,  task.attempt ) }
        time    = { time_scale ( 6.h,   task.attempt ) }
    }  

    // Outputs subworkflow
    withName: VCF2DIST {
        cpus    = { cpu_scale  ( 8,     task.attempt ) }
        memory  = { mem_scale  ( 48.GB,  task.attempt ) }
        time    = { time_scale ( 6.h,   task.attempt ) }
    }
    withName: PLOT_ORDINATION {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 12.GB,  task.attempt ) }
        time    = { time_scale ( 10.m,   task.attempt ) }
    }
    withName: PLOT_TREE {
        cpus    = { cpu_scale  ( 1,     task.attempt ) }
        memory  = { mem_scale  ( 12.GB,  task.attempt ) }
        time    = { time_scale ( 10.m,   task.attempt ) }
    }  
    withName: PLINK_IMPORT {
        cpus    = { cpu_scale  ( 8,     task.attempt ) }
        memory  = { mem_scale  ( 48.GB,  task.attempt ) }
        time    = { time_scale ( 6.h,   task.attempt ) }
    }
    withName: PLINK_PCA {
        cpus    = { cpu_scale  ( 8,     task.attempt ) }
        memory  = { mem_scale  ( 48.GB,  task.attempt ) }
        time    = { time_scale ( 6.h,   task.attempt ) }
    }
    withName: PLINK_REL {
        cpus    = { cpu_scale  ( 8,     task.attempt ) }
        memory  = { mem_scale  ( 48.GB,  task.attempt ) }
        time    = { time_scale ( 6.h,   task.attempt ) }
    }
    withName: PLINK_KING {
        cpus    = { cpu_scale  ( 8,     task.attempt ) }
        memory  = { mem_scale  ( 48.GB,  task.attempt ) }
        time    = { time_scale ( 6.h,   task.attempt ) }
    }
}


plugins {
    id 'nf-schema@2.0.0'                            // create schema to validate sample sheets and pipeline parameters
}


report {
    enabled             = true
    overwrite           = true
    file                = "output/run_info/report.html"
}


trace {
    enabled             = true
    overwrite           = true
    file                = "output/run_info/trace.tsv"
}


dag {
    enabled             = true
    overwrite           = true
    file                = "output/run_info/dag.html"
    verbose             = true
}


timeline {
    enabled             = true
    overwrite           = true
    file                = "output/run_info/timeline.html"
}


// Function to ensure that resource requirements don't go beyond a maximum limit
// from: https://github.com/nf-core/tools/blob/99961bedab1518f592668727a4d692c4ddf3c336/nf_core/pipeline-template/nextflow.config#L206-L237
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max time '${params.max_time}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}

// functions to increase resources in proportion to task attempts while staying within max limits
def cpu_scale ( obj, iteration ) {
    return check_max( obj * iteration , 'cpus' )
}

def mem_scale ( obj, iteration ) {
    return check_max( obj * iteration , 'memory' )
}

def time_scale ( obj, iteration ) {
    return check_max( obj * iteration , 'time' )
}